# Public / build-time values only — never put secrets here.

NEXT_PUBLIC_APP_NAME=Update Me

# Canonical site URL (SEO, sitemap, metadataBase). Local default:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-facing API base. Production should usually be same-origin via Nginx:
# NEXT_PUBLIC_API_BASE_URL=https://example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Used by Next.js rewrites for /api/backend/* (server-side only — not exposed to the browser)
BACKEND_ORIGIN=http://localhost:5000

# MapLibre / tiles (public)
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_API_KEY=
