# Server
NODE_ENV=development
PORT=5000
# Bind address. Use 127.0.0.1 in production behind Nginx.
HOST=0.0.0.0
API_PREFIX=/api/v1

# Frontend origin (CORS) — exact origin only; never *
CORS_ORIGIN=http://localhost:3000

# PostgreSQL / PostGIS
# Local foundation defaults (change password in real deployments):
# DATABASE_URL=postgresql://update_me_app:update_me_local_dev@127.0.0.1:5432/update_me
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/update_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=update_me
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false
# When DB_SSL=true, certificate verification is ON by default.
# Only set the following to false for broken lab certificates — never as a production default.
# DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20
# Single-box VPS with local Postgres may set:
# ALLOW_LOCAL_DB_IN_PRODUCTION=true

# Behind Nginx / load balancer, set true so rate limits see client IPs
TRUST_PROXY=false

# Auth — in production JWT_SECRET must be >=32 chars and not a placeholder
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=um_session

# Maps (MapLibre / OSM-compatible tile provider — leave empty until configured)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_STYLE_URL=
MAP_API_KEY=

# Object storage (optional — leave empty until configured; never expose to frontend)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Foreign Exchange (FX) Engine
# Provider credentials stay server-side — never expose to the frontend.
# ---------------------------------------------------------------------------
FX_SYNC_ON_STARTUP=true
FX_SYNC_INTERVAL_MS=86400000
FX_HISTORY_BACKFILL_DAYS=90
FX_PROVIDER_TIMEOUT_MS=12000
FX_OPEN_ER_API_ENABLED=true
FX_OPEN_ER_API_BASE_URL=https://open.er-api.com/v6
FX_HISTORY_CDN_BASE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api
FX_FRANKFURTER_ENABLED=false
FX_FRANKFURTER_BASE_URL=https://api.frankfurter.app
FX_CBN_ENABLED=false
FX_CBN_API_URL=
FX_CBN_API_KEY=
FX_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Government Official Updates Engine
# ---------------------------------------------------------------------------
OFFICIAL_SYNC_ON_STARTUP=true
OFFICIAL_SYNC_TICK_MS=300000
OFFICIAL_PROVIDER_TIMEOUT_MS=12000
OFFICIAL_ADMIN_TOKEN=

# Local mock feeds only — MUST remain unset/false in production
# INGESTION_ALLOW_LOCALHOST=true

# Optional Web Push (PWA). Leave unset to keep in-app-only delivery.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@updateme.local

# Graceful shutdown budget (ms)
# SHUTDOWN_TIMEOUT_MS=15000
