# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Frontend origin (CORS)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL / PostGIS
# Local foundation defaults (change password in real deployments):
# DATABASE_URL=postgresql://update_me_app:update_me_local_dev@127.0.0.1:5432/update_me
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/update_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=update_me
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false
# When DB_SSL=true, certificate verification is ON by default.
# Only set the following to false for broken lab certificates — never as a production default.
# DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20

# Behind Nginx / load balancer, set true so rate limits see client IPs
TRUST_PROXY=false

# Auth
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=um_session

# Maps (MapLibre / OSM-compatible tile provider — leave empty until configured)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_STYLE_URL=
MAP_API_KEY=

# Object storage (optional — leave empty until configured)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Foreign Exchange (FX) Engine
# Provider credentials stay server-side — never expose to the frontend.
# ---------------------------------------------------------------------------

# Run a sync shortly after API startup (set false to disable)
FX_SYNC_ON_STARTUP=true

# Default daily sync interval (ms). Lower for more frequent updates when the source supports it.
FX_SYNC_INTERVAL_MS=86400000

# How many days of history to backfill from providers that support it
FX_HISTORY_BACKFILL_DAYS=90

# Shared provider HTTP timeout
FX_PROVIDER_TIMEOUT_MS=12000

# Primary external market/indicative provider (NGN-capable, no API key)
FX_OPEN_ER_API_ENABLED=true
FX_OPEN_ER_API_BASE_URL=https://open.er-api.com/v6
FX_HISTORY_CDN_BASE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api

# Optional Frankfurter (ECB) — disabled by default (NGN coverage unreliable)
FX_FRANKFURTER_ENABLED=false
FX_FRANKFURTER_BASE_URL=https://api.frankfurter.app

# CBN official/reference provider — disabled until a verified endpoint is configured
FX_CBN_ENABLED=false
FX_CBN_API_URL=
FX_CBN_API_KEY=

# Optional shared secret for FX admin status/sync endpoints (header: x-fx-admin-token)
# Does NOT unlock /admin/* — staff session required for the Admin Dashboard.
# Moderators/staff can also call FX admin endpoints when signed in.
FX_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Government Official Updates Engine
# Only explicitly approved sources are ingested. No blind scraping.
# ---------------------------------------------------------------------------
OFFICIAL_SYNC_ON_STARTUP=true
# Scheduler tick — each source still uses its own sync_interval_minutes
OFFICIAL_SYNC_TICK_MS=300000
OFFICIAL_PROVIDER_TIMEOUT_MS=12000
# Admin token for source management / manual sync (header: x-official-admin-token)
# Does NOT unlock /admin/* and is not interchangeable with FX_ADMIN_TOKEN.
OFFICIAL_ADMIN_TOKEN=
