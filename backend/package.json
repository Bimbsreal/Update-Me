{
  "name": "update-me-backend",
  "version": "0.1.0",
  "description": "Update Me API — Nigeria-focused community real-time information platform",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrate.js --status",
    "seed:geo": "node src/db/seed-geography.js",
    "seed:geo:full": "node src/db/seed-geography-full.js",
    "test": "node --test tests/reports.test.js tests/traffic.test.js tests/fx.test.js tests/official.test.js tests/fuel.test.js tests/transport.test.js tests/prices.test.js tests/alerts.test.js tests/directions.test.js tests/community.test.js tests/notifications.test.js tests/admin.test.js tests/admin.http.test.js tests/explore.test.js tests/realtime.test.js tests/dataQuality.test.js tests/home.test.js tests/hardening.test.js tests/search.test.js tests/ingestion.test.js",
    "test:search": "node --test tests/search.test.js",
    "test:ingestion": "node --test tests/ingestion.test.js",
    "test:hardening": "node --test tests/hardening.test.js",
    "test:data-quality": "node --test tests/dataQuality.test.js",
    "test:realtime": "node --test tests/realtime.test.js",
    "test:explore": "node --test tests/explore.test.js",
    "test:admin": "node --test tests/admin.test.js tests/admin.http.test.js",
    "test:fx": "node --test tests/fx.test.js",
    "test:official": "node --test tests/official.test.js",
    "test:fuel": "node --test tests/fuel.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
